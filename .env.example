# Tao .env.mysql8 voi cac bien:
MYSQL_DATABASE=recipe_db
MYSQL_USER=recipe_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Tao .env.wordpress voi cac bien:
WORDPRESS_DB_HOST=mysql8:3306
WORDPRESS_DB_USER=recipe_user
WORDPRESS_DB_PASSWORD=CHANGE_ME
WORDPRESS_DB_NAME=recipe_db

# Neu giu service MariaDB cu, tao .env.mariadb voi:
# MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD, MYSQL_ROOT_PASSWORD

# Tren may moi, tao external volume nay truoc khi chay Compose:
# docker volume create recipe_wordpress_data
WORDPRESS_VOLUME_NAME=recipe_wordpress_data
